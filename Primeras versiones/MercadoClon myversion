<!DOCTYPE html>

<html>

<head>
    <title>MercadoClon</title>
 <style>
    .logo h1 {
       color: blue;
       font-size: 30px;
       
    padding: 20px;
    margin:10px;
    }
    
    h2 {
    color: violet;
    }
    
    .producto{
    background-color: lightgray;
    border: 1px solid gray;
    padding: 20px;
    margin:10px;
    border-radius:8px;
    width: 200px;
    transition: 0.2s;
    }
    
    .producto button{
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    font-size: 12px;
    cursor: pointer;
    }
    
    .producto:hover{
    transform:scale(1.1);
    }
    body {
    background-color: #ffffff;
    font-family: Verdana, sans-serif;
    }
    
    .usuario a {
    text-decoration: none;}
    
    .productos{
     display: flex;
     justify-content: center;
     }   
     
     header{
     display: flex;
     align-items: center;
     justify-content: space-between;
     
     background-color: #ffe600;
     padding: 15px;
     
    }
    .buscador input {
    width: 300px;
    height: 35px;
    padding: 5px;
    border: none;
    border-radius: 5px;
    }
    .buscador button {
    height: 35px;
    padding: 5px 15px;
    border: none;
    border-radius: 5px;
    
    
    }
    
    main h2 {
    text-align: center;
    }
    
    nav {
    display: flex;
    justify-content: center;
    gap: 50px;
    padding: 15px;
    }
    
    nav a{
    text-decoration: none;
    color: black;
    }
    
    nav a:hover{
    color: blue;
    text-decoration: underline;
    }
    
    .producto img{
    width: 200px;
    height: 200px;
    object-fit: contain;
    }
    
    
 </style>
   
</head>

<body>

    <header>
<div class="logo">
        <h1>Mercado Clon</h1>
</div>


<div class="buscador">
        <input type="text" placeholder="Buscar productos...">
        <button>Buscar</button>
</div>

<div class="usuario">
<a href="#">Mi cuenta</a>
<a href="#">🛒 Carrito </a>
</div>
        

    </header>


    <nav>

        <a href="#">Inicio</a>
        <a href="#">Categorías</a>
        <a href="#">Ofertas</a>
        <a href="#">Ayuda</a>

    </nav>


    <main>

        <h2>Productos destacados</h2>

<div class="productos">

    <div class="producto">
    <img src="https://tse1.mm.bing.net/th/id/OIP.cATqd9vosp6yaoXp0nDaYwHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" alt="Computador portátil">
        <h3>Computador portátil</h3>
        <p>Precio $2.500.000</p>
        <button>Comprar</button>
    </div>

    <div class="producto">
    <img src="https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/MQTP3?wid=1144&hei=1144&fmt=jpeg&qlt=90&.v=1687660671182" alt="Audifonos">
        <h3>Audífonos</h3>
        <p>Precio $150.000</p>
        <button>Comprar</button>
    </div>

    <div class="producto">
    <img src="https://media.falabella.com/sodimacCO/3037588/w=1036,h=832,f=webp,fit=contain,q=85" alt="Aspiradora">
        <h3>Aspiradora</h3>
        <p>Precio $600.000</p>
        <button>Comprar</button>
    </div>

</div>

    </main>


    <footer>

        <p>© 2026 MiClon</p>

    </footer>

</body>

</html>
