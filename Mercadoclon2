            if (currentSearch.trim() !== '') {
                const query = currentSearch.toLowerCase().trim();
                filtered = filtered.filter(p => 
                    p.title.toLowerCase().includes(query) ||
                    p.category.toLowerCase().includes(query)
                );
            }

            renderProducts(filtered);
            updateSectionTitle();
        }

        function updateSectionTitle() {
            if (currentCategory === 'todos') {
                sectionTitle.textContent = currentSearch ? `Resultados para "${currentSearch}"` : 'Productos destacados';
            } else {
                const categoryNames = {
                    electronica: 'Electrónica',
                    hogar: 'Hogar',
                    moda: 'Moda',
                    deportes: 'Deportes',
                    juguetes: 'Juguetes'
                };
                sectionTitle.textContent = currentSearch 
                    ? `Resultados en ${categoryNames[currentCategory]} para "${currentSearch}"`
                    : `${categoryNames[currentCategory]}`;
            }
        }

        function addToCart(productId) {
            cartCount++;
            cartCountElement.textContent = cartCount;
            // Animación simple
            cartCountElement.style.transform = 'scale(1.5)';
            setTimeout(() => {
                cartCountElement.style.transform = 'scale(1)';
            }, 200);
            // Aquí se podría agregar el producto a un array de carrito real
            console.log(`Producto ${productId} agregado al carrito. Total: ${cartCount}`);
        }

        function toggleFavorite(button) {
            button.textContent = button.textContent === '❤️' ? '💖' : '❤️';
        }

        // ==================== EVENTOS ====================
        // Delegación de eventos para acciones de productos
        productsGrid.addEventListener('click', (e) => {
            const addButton = e.target.closest('.btn-add-cart');
            if (addButton) {
                e.stopPropagation();
                addToCart(parseInt(addButton.dataset.id));
                return;
            }

            const favButton = e.target.closest('.btn-fav');
            if (favButton) {
                e.stopPropagation();
                toggleFavorite(favButton);
                return;
            }

            // Click en la tarjeta (excepto botones)
            const card = e.target.closest('.product-card');
            if (card) {
                const productId = parseInt(card.dataset.id);
                const product = products.find(p => p.id === productId);
                if (product) {
                    alert(`Producto: ${product.title}\nPrecio: ${formatPrice(product.price)}\n${product.installments ? product.installments : ''}\n${product.shipping ? product.shipping : ''}`);
                }
            }
        });

        // Búsqueda en tiempo real
        searchInput.addEventListener('input', (e) => {
            currentSearch = e.target.value;
            applyFilters();
        });

        // Evitar envío del formulario (recarga de página)
        searchForm.addEventListener('submit', (e) => {
            e.preventDefault();
            currentSearch = searchInput.value;
            applyFilters();
        });

        // Filtro por categoría
        categoryMenu.addEventListener('click', (e) => {
            const li = e.target.closest('li');
            if (li) {
                currentCategory = li.dataset.category;
                // Cerrar el dropdown manualmente (en móvil)
                document.querySelector('.dropdown-menu').style.display = 'none';
                setTimeout(() => {
                    document.querySelector('.dropdown-menu').style.display = '';
                }, 100);
                applyFilters();
            }
        });

        // ==================== CARRUSEL ====================
        const carouselTrack = document.getElementById('carouselTrack');
        const slides = carouselTrack.children;
        const totalSlides = slides.length;
        const dotsContainer = document.getElementById('dots');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        let currentSlide = 0;
        let autoplayInterval;

        // Crear puntos
        for (let i = 0; i < totalSlides; i++) {
            const dot = document.createElement('div');
            dot.classList.add('dot');
            if (i === 0) dot.classList.add('active');
            dot.addEventListener('click', () => goToSlide(i));
            dotsContainer.appendChild(dot);
        }

        const dots = dotsContainer.querySelectorAll('.dot');

        function updateCarousel() {
            carouselTrack.style.transform = `translateX(-${currentSlide * 100}%)`;
            dots.forEach((dot, index) => {
                dot.classList.toggle('active', index === currentSlide);
            });
        }

        function goToSlide(index) {
            currentSlide = index;
            if (currentSlide < 0) currentSlide = totalSlides - 1;
            if (currentSlide >= totalSlides) currentSlide = 0;
            updateCarousel();
            resetAutoplay();
        }

        function nextSlide() {
            goToSlide(currentSlide + 1);
        }

        function prevSlide() {
            goToSlide(currentSlide - 1);
        }

        function startAutoplay() {
            autoplayInterval = setInterval(nextSlide, 4000);
        }

        function resetAutoplay() {
            clearInterval(autoplayInterval);
            startAutoplay();
        }

        prevBtn.addEventListener('click', prevSlide);
        nextBtn.addEventListener('click', nextSlide);

        // Pausar autoplay al pasar el mouse
        const carousel = document.getElementById('carousel');
        carousel.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
        carousel.addEventListener('mouseleave', startAutoplay);

        // Iniciar autoplay
        startAutoplay();

        // ==================== INICIALIZACIÓN ====================
        applyFilters();
    </script>
</body>
</html>
